{
  "name": "leish-studio-google",
  "version": "1.0.0",
  "description": "Leish! Aesthetic Marketplace — full-stack Vite + Express app with Gemini AI studios",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "tsx dev.ts",
    "build": "tsc --noEmit && vite build && esbuild server.ts --bundle --platform=node --format=esm --target=node22 --external:bcrypt --outfile=api/handler.js --banner:js=\"import { createRequire } from 'module'; import { fileURLToPath } from 'url'; import { dirname } from 'path'; const require = createRequire(import.meta.url); const __filename = fileURLToPath(import.meta.url); const __dirname = dirname(__filename);\"",
    "start": "NODE_ENV=production pnpm exec tsx dev.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "verify": "pnpm run typecheck && pnpm test",
    "emulator:firestore": "npx --yes firebase-tools@13.35.1 emulators:start --only firestore --project leish-local",
    "seed:firestore": "FIRESTORE_EMULATOR_HOST=\"${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080}\" FIREBASE_PROJECT_ID=leish-local tsx scripts/seed-firestore.ts",
    "test:firestore": "FIRESTORE_EMULATOR_HOST=\"${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080}\" FIREBASE_PROJECT_ID=leish-local vitest run server/firestore-store.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/react": "^4.0.140",
    "@google/genai": "^2.27.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "@vis.gl/react-google-maps": "^1.10.1",
    "ai": "^7.0.137",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "firebase-tools": "13.35.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2",
    "vercel": "^64.5.0",
    "vite": "^6.4.4",
    "vitest": "^5.0.3"
  }
}
