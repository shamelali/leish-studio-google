{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.+)/(.+)",
      "destination": "/api/handler?...path=$1/$2"
    },
    {
      "source": "/api/(.+)",
      "destination": "/api/handler?...path=$1"
    },
    {
      "source": "/healthz",
      "destination": "/api/handler?...path=healthz"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
