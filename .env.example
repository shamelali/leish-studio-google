# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA NIM / build.nvidia.com (OpenAI-compatible API). This takes precedence
# for the wedding concierge when set. Pick a NIM model that supports tool calls.
# NVIDIA_API_KEY="nvapi-..."
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_CONCIERGE_MODEL="meta/llama-3.2-11b-vision-instruct"

# Optional OpenAI-compatible fallback for the concierge (used after NVIDIA and
# before Gemini); OpenRouter is one example.
# OPENAI_API_KEY="MY_OPENAI_OR_OPENROUTER_KEY"
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# OPENAI_CONCIERGE_MODEL="openai/gpt-4o-mini"

# Optional server-side model override for the Vercel AI SDK wedding concierge.
# Defaults to the app's existing Gemini model. No Vercel API key or MCP needed.
# GEMINI_CONCIERGE_MODEL="gemini-3.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Required in production. Use a randomly generated value of at
# least 32 bytes and store it in the deployment secret manager; never commit a
# real value. Local tests may omit it and use the isolated development fallback.
JWT_SECRET="GENERATE_A_RANDOM_SECRET_FOR_LOCAL_USE"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive salon & MUA mapping.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY_HERE"

# Server-side data backend. JSON is the local/test fallback. Production must
# explicitly use firestore so a deploy never serves an empty/ephemeral store.
# Never expose these values as VITE_* variables.
STORE_BACKEND="json"
FIREBASE_PROJECT_ID="your-gcp-project-id"

# Optional Firestore emulator endpoint, for local development only.
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# For Firestore outside Google-managed runtime, point ADC at a server-only
# service-account JSON file. Do not commit this file or put its contents here.
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

# Alternatively, configure the Admin SDK with an explicit service-account
# cert (also used to verify Google ID tokens for POST /api/auth/google).
# In Vercel: paste the private key with real newlines escaped as \n.
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@....iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Server-side Google Maps Platform key for live travel-distance estimates
# (Distance Matrix). Restrict it by IP (server use only). When unset, the
# venue estimator serves clearly-labelled sample distances instead.
# GOOGLE_MAPS_SERVER_KEY="YOUR_SERVER_SIDE_MAPS_KEY_HERE"

# Brevo transactional email for booking confirmations. When unset, the
# server skips sending (bookings still confirm normally).
# BREVO_API_KEY="xkeysib-..."
# FROM_EMAIL="hello@leish.studio"
# FROM_NAME="Leish!"
